# Do not commit a real secrets.yaml file. Keep this .example file only.
#
# Apply after replacing all placeholder values with production values:
#   cp k8s/secrets.yaml.example k8s/secrets.yaml
#   # edit k8s/secrets.yaml
#   kubectl apply -f k8s/secrets.yaml
#
# Prefer creating secrets directly with kubectl when possible:
#   kubectl create secret generic team-workspace-secrets \
#     --from-literal=spring-datasource-url='jdbc:postgresql://...' \
#     --from-literal=spring-datasource-username='...' \
#     --from-literal=spring-datasource-password='...' \
#     --from-literal=app-jwt-secret='...'
apiVersion: v1
kind: Secret
metadata:
  name: team-workspace-secrets
  namespace: default
type: Opaque
stringData:
  spring-datasource-url: "jdbc:postgresql://db-host:5432/team_workspace?sslmode=require"
  spring-datasource-username: "team_workspace_user"
  spring-datasource-password: "CHANGE_ME_PASSWORD"
  app-jwt-secret: "CHANGE_ME_JWT_SECRET"